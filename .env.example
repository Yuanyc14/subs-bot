# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (empty = public)
ALLOWED_USER_IDS=

# Public URL for subscription/short-link endpoints (http://YOUR_IP:8787)
PUBLIC_BASE_URL=http://127.0.0.1:8787

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8787

# Data directory (optional, defaults to ./data)
DATA_DIR=/opt/subs-bot/data
DB_PATH=/opt/subs-bot/data/subs.db
